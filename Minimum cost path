import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[][] grid = new int[n][m];
        int[][] dp = new int[n][m];

        // Read grid
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                grid[i][j] = sc.nextInt();
            }
        }

        // Starting cell
        dp[0][0] = grid[0][0];

        // Fill DP table
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (i == 0 && j == 0)
                    continue;

                int min = Integer.MAX_VALUE;

                // From top
                if (i > 0)
                    min = Math.min(min, dp[i - 1][j]);

                // From left
                if (j > 0)
                    min = Math.min(min, dp[i][j - 1]);

                // From diagonal
                if (i > 0 && j > 0)
                    min = Math.min(min, dp[i - 1][j - 1]);

                dp[i][j] = grid[i][j] + min;
            }
        }

        System.out.println(dp[n - 1][m - 1]);
    }
}
