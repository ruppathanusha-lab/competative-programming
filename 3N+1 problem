import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int a=sc.nextInt();
      int b=sc.nextInt();
      int i=a;
      int j=b;
       if(i>j){
        int temp=i;
        i=j;
        j=temp;
       }
       int maxlen=0;
       for(int num=i;num<=j;num++){
        int n=num;
         int count=1;
        while (n != 1) {
    if (n % 2 == 0) {
        n = n / 2;
    } else {
        n = 3 * n + 1;
    }

    count++;
}
          maxlen=Math.max(maxlen,count);
      }
      System.out.print(a+" "+b+" "+maxlen);
    }
}
