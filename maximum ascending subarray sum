import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int maxs=arr[0];
        int cur=arr[0];
        for(int i=1;i<arr.length;i++){
            if(arr[i]>arr[i-1]){
                cur=cur+arr[i];
            }
            else{
                cur=arr[i];
            }
            if(cur>maxs){
                maxs=cur;
            }
        }
       System.out.println(maxs); 
    }
}
